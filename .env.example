# Cadence environment configuration
#
# Copy to `.env` next to docker-compose.yml for the self-host stack:
#   cp .env.example .env
#
# The CLI vars at the bottom are NOT used by docker compose — they belong in
# your dev machine's shell profile (export or direnv).

# ── Relay (docker compose) ────────────────────────────────────────────────
# GitHub OAuth app for the relay's browser portal (authorization-code flow
# with client secret; callback URL = <CADENCE_RELAY_PUBLIC_URL>/v1/oauth/callback).
# All four must be set together — partial sets fail the relay at startup.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
CADENCE_RELAY_PUBLIC_URL=https://cadence.example.com
CADENCE_APP_URL=https://cadence.example.com

# ── CLI (dev machine shell, not docker compose) ───────────────────────────
# GitHub OAuth app for device-flow login (public app, no secret needed).
CADENCE_GITHUB_CLIENT_ID=
# Relay base URL the CLI pairs against (or pass --relay-url at start).
CADENCE_RELAY_URL=https://cadence.example.com
# Optional: intercept timeout override in milliseconds (default 900000 = 15 min).
# CADENCE_INTERCEPT_TIMEOUT_MS=900000
